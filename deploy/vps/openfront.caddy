# Import this file from the existing /etc/caddy/Caddyfile.
# Replace the hostname only; Caddy already owns 80/443 for Tralo.
openfront.azertixyt.fr {
  encode zstd gzip
  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
  @private path /api/adminbot/* /w*/api/adminbot/* /platform-api/cluster/checkin /platform-api/join_verify /platform-api/custom_tribes
  respond @private 404
  handle /admin {
    rewrite * /admin-page
    reverse_proxy 127.0.0.1:3400
  }
  handle /tournaments {
    rewrite * /tournaments-page
    reverse_proxy 127.0.0.1:3400
  }
  handle /profile {
    rewrite * /profile-page
    reverse_proxy 127.0.0.1:3400
  }
  handle /login {
    rewrite * /login-page
    reverse_proxy 127.0.0.1:3400
  }
  handle_path /platform-api/* {
    @result_write method POST
    @archives path /game/*
    route {
      @archive_write {
        method POST
        path /game/*
      }
      respond @archive_write 404
      reverse_proxy 127.0.0.1:3400
    }
  }
  handle {
    reverse_proxy 127.0.0.1:3300
  }
}
